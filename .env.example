# Telegram API；所有帳號可共用同一組 API ID / Hash
TG_API_ID=123456
TG_API_HASH=replace_me

# 控制台登入
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_password
APP_SECRET=replace_with_at_least_32_random_characters
COOKIE_SECURE=true
COOKIE_MAX_AGE=43200

# 用下列命令產生：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=replace_with_fernet_key

# Railway 請掛載 Volume 至 /data
DATA_DIR=/data
MEMORY_TTL_HOURS=24
MAX_HISTORY_MESSAGES=16
MAX_INPUT_CHARS=4000
LOG_LEVEL=INFO
